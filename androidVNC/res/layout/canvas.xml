<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    >

<android.androidVNC.VncCanvas
    android:id="@+id/vnc_canvas"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_gravity="bottom|center"
    >
</android.androidVNC.VncCanvas>

<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
 android:layout_gravity="top|right" android:orientation="horizontal">
<Button android:id="@+id/buttonScreenScale" style="?android:attr/buttonStyleSmall"
 android:layout_width="wrap_content" android:layout_height="wrap_content"
 android:text="@string/scale_short" android:contentDescription="@string/scale_chooser"/>
<Button
    android:id="@+id/buttonScreenOrientation"
    style="?android:attr/buttonStyleSmall"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|right"
    android:layout_margin="6dip"
    android:text="@string/screen_orientation_short"
    android:contentDescription="@string/screen_orientation"
/>
</LinearLayout>
  
<com.antlersoft.android.zoomer.ZoomControls
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/zoomer"
    android:layout_gravity="bottom|center"
/>

</FrameLayout>
